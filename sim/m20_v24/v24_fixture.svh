m20_v23_io_model io(.gpo(dbg_gpo),.*);
integer microcycles=0;logic compare_enabled=0;
task drive_keys(input integer value);begin requested_keys=value[5:0];key_sample_ce=1;@(posedge sys_clk);#1ps;key_sample_ce=0;end endtask
task park;begin stop_request=1;run_enable=0;wait(parked);@(negedge sys_clk);end endtask
task start;begin stop_request=0;run_enable=1;end endtask
task wait_commit;begin @(posedge master_hold);end endtask
task wait_observe;begin @(posedge slave_open);#200;end endtask
task check_states;begin
if({dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped}!=={ref_dbg_pc,ref_dbg_ar,ref_dbg_a,ref_dbg_z,ref_dbg_c,ref_dbg_gpo,ref_dbg_state,ref_halted,ref_trapped})$fatal(1,"V23_FOUR_WAY_STATE %s time=%0t DUT=%h REF=%h", "ref_",$time,{dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped},{ref_dbg_pc,ref_dbg_ar,ref_dbg_a,ref_dbg_z,ref_dbg_c,ref_dbg_gpo,ref_dbg_state,ref_halted,ref_trapped});
if({dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped}!=={ideal_dbg_pc,ideal_dbg_ar,ideal_dbg_a,ideal_dbg_z,ideal_dbg_c,ideal_dbg_gpo,ideal_dbg_state,ideal_halted,ideal_trapped})$fatal(1,"V23_FOUR_WAY_STATE %s time=%0t DUT=%h REF=%h", "ideal_",$time,{dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped},{ideal_dbg_pc,ideal_dbg_ar,ideal_dbg_a,ideal_dbg_z,ideal_dbg_c,ideal_dbg_gpo,ideal_dbg_state,ideal_halted,ideal_trapped});
if({dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped}!=={switch_dbg_pc,switch_dbg_ar,switch_dbg_a,switch_dbg_z,switch_dbg_c,switch_dbg_gpo,switch_dbg_state,switch_halted,switch_trapped})$fatal(1,"V23_FOUR_WAY_STATE %s time=%0t DUT=%h REF=%h", "switch_",$time,{dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state,halted,trapped},{switch_dbg_pc,switch_dbg_ar,switch_dbg_a,switch_dbg_z,switch_dbg_c,switch_dbg_gpo,switch_dbg_state,switch_halted,switch_trapped});
end endtask
always @(posedge master_hold)if(compare_enabled && !rst)begin
 check_states();microcycles=microcycles+1;
 if($isunknown({rom_data,ram_ce,ram_oe,ram_we,retire_valid}))$fatal(1,"V23_UNKNOWN_COMMIT");
 if(dut.state_qm!==dut.state_d)$fatal(1,"V23_MASTER_NOT_SETTLED");
 if({ram_ce,ram_oe,ram_we,retire_valid}!=={ref_ram_ce,ref_ram_oe,ref_ram_we,ref_retire_valid})$fatal(1,"V23_BUS_CONTROL ref_");
 if(ram_ce && ram_addr!==ref_ram_addr)$fatal(1,"V23_RAM_ADDRESS");
 if(retire_valid && {retire_pc,retire_instruction,retire_next_pc,retire_a,retire_ar,retire_z,retire_c,retire_gpo}!=={ref_retire_pc,ref_retire_instruction,ref_retire_next_pc,ref_retire_a,ref_retire_ar,ref_retire_z,ref_retire_c,ref_retire_gpo})$fatal(1,"V23_RETIRE_PAYLOAD");
 if({ram_ce,ram_oe,ram_we,retire_valid}!=={ideal_ram_ce,ideal_ram_oe,ideal_ram_we,ideal_retire_valid})$fatal(1,"V23_BUS_CONTROL ideal_");
 if(ram_ce && ram_addr!==ideal_ram_addr)$fatal(1,"V23_RAM_ADDRESS");
 if(retire_valid && {retire_pc,retire_instruction,retire_next_pc,retire_a,retire_ar,retire_z,retire_c,retire_gpo}!=={ideal_retire_pc,ideal_retire_instruction,ideal_retire_next_pc,ideal_retire_a,ideal_retire_ar,ideal_retire_z,ideal_retire_c,ideal_retire_gpo})$fatal(1,"V23_RETIRE_PAYLOAD");
 if({ram_ce,ram_oe,ram_we,retire_valid}!=={switch_ram_ce,switch_ram_oe,switch_ram_we,switch_retire_valid})$fatal(1,"V23_BUS_CONTROL switch_");
 if(ram_ce && ram_addr!==switch_ram_addr)$fatal(1,"V23_RAM_ADDRESS");
 if(retire_valid && {retire_pc,retire_instruction,retire_next_pc,retire_a,retire_ar,retire_z,retire_c,retire_gpo}!=={switch_retire_pc,switch_retire_instruction,switch_retire_next_pc,switch_retire_a,switch_retire_ar,switch_retire_z,switch_retire_c,switch_retire_gpo})$fatal(1,"V23_RETIRE_PAYLOAD");
 if(retire_valid && {retire_ram_valid,retire_ram_write,retire_is_memory,retire_instruction_cycles}!=={ref_retire_ram_valid,ref_retire_ram_write,ref_retire_is_memory,ref_retire_instruction_cycles})$fatal(1,"V23_RETIRE_METADATA");
 if(retire_valid && retire_ram_valid && !retire_ram_write && ram_rdata!==ref_ram_rdata)$fatal(1,"V23_READ_TRANSACTION_VALUE");
 if(ram_we && ram_wdata!==ref_ram_wdata)$fatal(1,"V23_WRITE_TRANSACTION_VALUE");
 if(retire_valid && {retire_ram_valid,retire_ram_write,retire_is_memory,retire_instruction_cycles}!=={ideal_retire_ram_valid,ideal_retire_ram_write,ideal_retire_is_memory,ideal_retire_instruction_cycles})$fatal(1,"V23_RETIRE_METADATA");
 if(retire_valid && retire_ram_valid && !retire_ram_write && ram_rdata!==ideal_ram_rdata)$fatal(1,"V23_READ_TRANSACTION_VALUE");
 if(ram_we && ram_wdata!==ideal_ram_wdata)$fatal(1,"V23_WRITE_TRANSACTION_VALUE");
 if(retire_valid && {retire_ram_valid,retire_ram_write,retire_is_memory,retire_instruction_cycles}!=={switch_retire_ram_valid,switch_retire_ram_write,switch_retire_is_memory,switch_retire_instruction_cycles})$fatal(1,"V23_RETIRE_METADATA");
 if(retire_valid && retire_ram_valid && !retire_ram_write && ram_rdata!==switch_ram_rdata)$fatal(1,"V23_READ_TRANSACTION_VALUE");
 if(ram_we && ram_wdata!==switch_ram_wdata)$fatal(1,"V23_WRITE_TRANSACTION_VALUE");
end
always @(master_hold or slave_open)begin #1ps;if(!master_hold && slave_open)$fatal(1,"V23_SCHEDULER_OVERLAP");end
task advance;begin wait_commit();wait_observe();if(compare_enabled)check_states();end endtask
task prime;begin prime_rom=1;@(posedge sys_clk);#1ps;prime_rom=0;repeat(5)@(posedge sys_clk);#1;end endtask
task reset_all;begin compare_enabled=0;checks_enable=0;park();rst=1;start();advance();advance();park();
 if({dbg_pc,dbg_ar,dbg_a,dbg_z,dbg_c,dbg_gpo,dbg_state}!=={12'd0,8'd0,4'd0,1'b1,1'b0,4'd8,3'd0})$fatal(1,"V23_LATCH_INITIALIZATION");
 rst=0;start();advance();park();if(dbg_state!==1)$fatal(1,"V23_RESET_TO_FETCH");end endtask
