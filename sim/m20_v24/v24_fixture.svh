// V2.4 common-reference fixture: source feedback sampled by FPGA on opposite edge.
logic clk_ref=0;integer oscillator_edges=0;
`ifdef V24_MODE_C
always begin #(450+5*(oscillator_edges%3));clk_ref=1;#(540+10*(oscillator_edges%2));clk_ref=0;oscillator_edges=oscillator_edges+1;end
`else
always #500 clk_ref=~clk_ref;
`endif
wire sys_clk=~clk_ref;
logic sched_reset=1,rst=1,run_enable=0,stop_request=0,step_request=0,prime_rom=0;
logic checks_enable=0,key_sample_ce=0;logic [5:0] requested_keys=0;wire [5:0] keys;wire [3:0]observed_gpo;
`ifdef V24_SLOW_CPU
localparam real CDMIN=2,CDMAX=5,CSMIN=2,CSMAX=5.2,LD=2,LS=3,MO=10,SO=5,BS=2;
localparam real GC=2,GI=6,GD=1,GS=2,GB=0.2,GO=1;
`elsif V24_TIMED
localparam real CDMIN=0.2,CDMAX=0.8,CSMIN=0.3,CSMAX=1,LD=0.4,LS=0.5,MO=1,SO=0.5,BS=0.3;
localparam real GC=0.5,GI=2,GD=0.2,GS=0.3,GB=0.05,GO=0.1;
`else
localparam real CDMIN=0,CDMAX=0,CSMIN=0,CSMAX=0,LD=0,LS=0,MO=0,SO=0,BS=0;
localparam real GC=0,GI=0,GD=0,GS=0,GB=0,GO=0;
`endif
localparam bit CF=1;
wire master_hold,slave_open,source_busy,source_fault,source_ack;
wire [3:0] source_phase;
wire parked=!source_busy && source_phase==8;
wire clk=master_hold;
wire commit_ce=source_busy && source_phase==7;
wire ram_sample_ce=source_busy && source_phase==0;
wire rom_read_ce=source_busy && source_phase==15;
wire observe_ce=rom_read_ce;
wire [1:0]phase=(source_phase[3:2]==0)?0:(source_phase[3:2]==1)?1:(source_phase[3:2]==3)?2:3;
`ifdef V24_MODE_A
wire scheduler_parked;wire [1:0]a_phase;integer a_tick;
swc_two_phase_scheduler #(.MASTER_TICKS(3),.SLAVE_TICKS(3),.DEAD1_TICKS(1),.DEAD2_TICKS(1),.ROM_TICK(0),.RAM_TICK(0),.OBSERVE_TICK(0)) scheduler(
 .sys_clk(clk_ref),.reset(sched_reset),.run_enable(run_enable),.stop_request(stop_request),.step_request(step_request),
 .master_hold(master_hold),.slave_open(slave_open),.parked(scheduler_parked),.phase(a_phase),.phase_tick(a_tick),
 .commit_clk(),.commit_ce(),.rom_read_ce(),.ram_sample_ce(),.observe_ce());
assign source_busy=!scheduler_parked;assign source_fault=0;assign source_ack=0;
assign source_phase=(a_phase==0)?((a_tick==0)?0:(a_tick==1)?1:3):(a_phase==1)?7:(a_phase==2)?((a_tick==0)?15:(a_tick==1)?14:12):8;
`else
swc157_phasegen_v24 #(.COMB_NS(GC),.INTERLOCK_NS(GI),.LOCAL_DATA_NS(GD),.LOCAL_SELECT_NS(GS),.LOCAL_MASTER_NS(GO),.LOCAL_SLAVE_NS(GO),.LOCAL_SKEW_NS(GB)) generator(
 .clk_ref(clk_ref),.rst(sched_reset),.run_request(run_enable && !stop_request),.step_request(step_request),
 .master_hold(master_hold),.slave_open(slave_open),.phase_state(source_phase),.busy(source_busy),.fault(source_fault),.step_ack(source_ack),.local_h(),.local_s());
`endif
