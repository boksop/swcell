integer overlap_seen=0;
always @(posedge sys_clk)begin overlap_seen=dut.g_latch.b0.overlap_events+dut.g_latch.b1.overlap_events+dut.g_latch.b2.overlap_events+dut.g_latch.b3.overlap_events+dut.g_latch.b4.overlap_events+dut.g_latch.b5.overlap_events+dut.g_latch.b6.overlap_events+dut.g_latch.b7.overlap_events+dut.g_latch.b8.overlap_events+dut.g_latch.b9.overlap_events+dut.g_latch.b10.overlap_events+dut.g_latch.b11.overlap_events+dut.g_latch.b12.overlap_events+dut.g_latch.b13.overlap_events+dut.g_latch.b14.overlap_events+dut.g_latch.b15.overlap_events+dut.g_latch.b16.overlap_events+dut.g_latch.b17.overlap_events+dut.g_latch.b18.overlap_events+dut.g_latch.b19.overlap_events+dut.g_latch.b20.overlap_events+dut.g_latch.b21.overlap_events+dut.g_latch.b22.overlap_events+dut.g_latch.b23.overlap_events+dut.g_latch.b24.overlap_events+dut.g_latch.b25.overlap_events+dut.g_latch.b26.overlap_events+dut.g_latch.b27.overlap_events+dut.g_latch.b28.overlap_events+dut.g_latch.b29.overlap_events+dut.g_latch.b30.overlap_events+dut.g_latch.b31.overlap_events+dut.g_latch.b32.overlap_events;if(observe_ce && overlap_seen>0)$display("V23_PRESSURE_OVERLAP_EVENTS=%0d",overlap_seen);end

realtime last_ram_change=-1e9;
always @(ram_rdata)last_ram_change=$realtime;
always @(rom_data)if(compare_enabled && !master_hold)$fatal(1,"V23_ROM_CHANGED_MASTER_OPEN");
always @(keys)if(compare_enabled && !master_hold)$fatal(1,"V23_KEYS_CHANGED_MASTER_OPEN");
always @(posedge master_hold)if(compare_enabled && !rst)begin
 if(retire_valid && retire_ram_valid && !retire_ram_write && (mem.sample_epoch!=mem.response_epoch || $isunknown(ram_rdata)))$fatal(1,"V23_RAM_RESPONSE_NOT_READY");
 if(retire_valid && retire_ram_valid && !retire_ram_write && $realtime-mem.last_response<mem.ram_delay_ns+2.0)$fatal(1,"V23_RAM_RESPONSE_SETUP");
 if(retire_valid && retire_ram_valid && !retire_ram_write && $realtime-last_ram_change<2.0)$fatal(1,"V23_RAM_DATA_SETUP_WINDOW");
 if(mem.pending_write!==(ram_ce && ram_we))$fatal(1,"V23_PENDING_WRITE_SNAPSHOT");
end

realtime source_changed=-1e9,rom_address_changed=-1e9;
always @(source_phase)source_changed=$realtime;
always @(rom_addr)rom_address_changed=$realtime;
always @(posedge sys_clk)if(compare_enabled && !rst && source_busy)begin
 if($realtime-source_changed<100)$fatal(1,"V24_PHASE_FEEDBACK_SETUP");
 if(rom_read_ce && $realtime-rom_address_changed<100)$fatal(1,"V24_ROM_ADDRESS_SETUP");
end
always @(source_fault)if(compare_enabled && source_fault)$fatal(1,"V24_CLOCK_SOURCE_FAULT");
