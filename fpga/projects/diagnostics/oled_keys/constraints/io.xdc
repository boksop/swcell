# Generated from board oled_keys.json; independent diagnostic, no old LED/M11 constraints.
set_property PACKAGE_PIN D27 [get_ports sys_clk]
set_property PACKAGE_PIN Y28 [get_ports OLED_RST_N]
set_property PACKAGE_PIN M30 [get_ports OLED_DC]
set_property PACKAGE_PIN M29 [get_ports OLED_SCK]
set_property PACKAGE_PIN N24 [get_ports OLED_MOSI]
set_property PACKAGE_PIN P22 [get_ports OLED_CS_N]
set_property PACKAGE_PIN N27 [get_ports RST_N]
set_property PACKAGE_PIN AK28 [get_ports KEY0]
set_property PACKAGE_PIN AF26 [get_ports KEY1]
set_property PACKAGE_PIN AE26 [get_ports KEY2]
set_property PACKAGE_PIN AG28 [get_ports KEY3]
set_property PACKAGE_PIN AF27 [get_ports KEY4]
set_property PACKAGE_PIN N19 [get_ports KEY5]
set_property PACKAGE_PIN M19 [get_ports KEY6]
set_property PACKAGE_PIN M27 [get_ports KEY7]
set_property PACKAGE_PIN AD27 [get_ports LED0]
set_property PACKAGE_PIN AD28 [get_ports LED1]
set_property PACKAGE_PIN AE29 [get_ports LED2]
set_property PACKAGE_PIN AD29 [get_ports LED3]
set_property PACKAGE_PIN AB28 [get_ports LED4]
set_property PACKAGE_PIN AA27 [get_ports LED5]
set_property PACKAGE_PIN Y30 [get_ports LED6]
set_property PACKAGE_PIN Y29 [get_ports LED7]
set_property PACKAGE_PIN W23 [get_ports UART_TX]
set_property PACKAGE_PIN V20 [get_ports UART_RXD]
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property DRIVE 4 [get_ports {OLED_RST_N OLED_DC OLED_SCK OLED_MOSI OLED_CS_N UART_TX LED0 LED1 LED2 LED3 LED4 LED5 LED6 LED7}]
set_property SLEW SLOW [get_ports {OLED_RST_N OLED_DC OLED_SCK OLED_MOSI OLED_CS_N UART_TX LED0 LED1 LED2 LED3 LED4 LED5 LED6 LED7}]
set_property PULLUP true [get_ports {RST_N KEY0 KEY1 KEY2 KEY3 KEY4 KEY5 KEY6 KEY7 UART_RXD}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
